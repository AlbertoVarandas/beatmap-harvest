<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Symbols inside the binaries, so a published build has no loose .pdb files. -->
    <DebugType>embedded</DebugType>

    <Version>0.1.0</Version>
    <Authors>Kriptonyte</Authors>
    <Product>Beatmap Harvest</Product>
    <Copyright>Copyright (c) 2026 Kriptonyte</Copyright>
    <RepositoryUrl>https://github.com/AlbertoVarandas/beatmap-harvest</RepositoryUrl>
  </PropertyGroup>
</Project>
