<Window x:Class="BeatmapHarvest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:BeatmapHarvest.App"
        xmlns:components="clr-namespace:BeatmapHarvest.App.Components"
        Title="Beatmap Harvest"
        Icon="Assets/app.ico"
        Width="1360" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1c1719">
    <local:EmbeddedBlazorWebView HostPage="wwwroot\index.html" Services="{DynamicResource services}">
        <local:EmbeddedBlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </local:EmbeddedBlazorWebView.RootComponents>
    </local:EmbeddedBlazorWebView>
</Window>
