@* Adds the selected beatmapsets to an osu! collection (kept in memory until saved on the Collections page). *@
@inject CollectionsService Collections

<div class="modal-backdrop" @onclick="CloseAsync">
    <div class="modal small-modal" role="dialog" aria-label="@L["Add to collection"]" @onclick:stopPropagation>
        <div class="modal-body">
            <h2>@L.F(Mapsets.Count == 1 ? "Add {0} map to a collection" : "Add {0} maps to a collection", Mapsets.Count)</h2>

            @if (_db is null)
            {
                <StableOnlyNotice What="collections" />
            }
            else
            {
                <label class="field">
                    <span>@L["Collection"]</span>
                    <select class="input" @bind="_target" disabled="@_busy">
                        @foreach (var collection in _db.Collections)
                        {
                            <option value="@collection.Name">@collection.Name (@collection.Hashes.Count)</option>
                        }
                        <option value="@NewOption">@L["New collection…"]</option>
                    </select>
                </label>
                @if (_target == NewOption)
                {
                    <label class="field">
                        <span>@L["Name"]</span>
                        <input class="input" @bind="_newName" @bind:event="oninput" disabled="@_busy" />
                    </label>
                }
                <label class="check-field">
                    <input type="checkbox" @bind="_includeMissing" disabled="@_busy" />
                    @L["Also add maps not in osu! yet (looks each one up on osu!, about one per second)"]
                </label>

                @if (_busy)
                {
                    <div class="progress-row">
                        <div class="progress"><div style="width:@Format.Percent(_total == 0 ? 0 : (double)_done / _total)"></div></div>
                        <b>@_done/@_total</b>
                    </div>
                }
                @if (_message is not null)
                {
                    <div class="callout @(_ok ? "ok" : "error")">@_message</div>
                }

                <div class="actions">
                    @if (_finished)
                    {
                        <a class="btn primary" href="collections">@L["Open Collections"]</a>
                        <button class="btn" @onclick="CloseAsync">@L["Close"]</button>
                    }
                    else
                    {
                        <button class="btn primary" disabled="@(_busy || TargetName().Length == 0)" @onclick="AddAsync">@L["Add"]</button>
                        <button class="btn" @onclick="CloseAsync">@L[_busy ? "Stop" : "Cancel"]</button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private const string NewOption = "\u0001new";

    [Parameter, EditorRequired] public IReadOnlyCollection<MapsetInfo> Mapsets { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }

    private CollectionDatabase? _db;
    private string _target = NewOption;
    private string _newName = "Beatmap Harvest";
    private bool _includeMissing;
    private bool _busy;
    private bool _finished;
    private bool _ok;
    private string? _message;
    private int _done;
    private int _total;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        try
        {
            _db = Collections.Get();
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException)
        {
            _message = L.F("Could not read collection.db: {0}", ex.Message);
        }
        if (_db is { Collections.Count: > 0 })
            _target = _db.Collections[0].Name;
    }

    private string TargetName() => (_target == NewOption ? _newName : _target).Trim();

    private async Task AddAsync()
    {
        _busy = true;
        _message = null;
        _cts = new CancellationTokenSource();
        var progress = new Progress<(int Done, int Total)>(p =>
        {
            (_done, _total) = p;
            StateHasChanged();
        });
        try
        {
            var result = await Collections.AddAsync(TargetName(), Mapsets, _includeMissing, progress, _cts.Token);
            _ok = true;
            _finished = true;
            _message = L.F("Added {0} difficulties to \"{1}\".", result.Added, TargetName())
                       + (result.NotFound > 0
                           ? " " + L.F(_includeMissing ? "{0} maps were skipped (not found on osu!)." : "{0} maps were skipped (not in osu! yet).", result.NotFound)
                           : "")
                       + " " + L["Save on the Collections page to write it to osu!."];
        }
        catch (OperationCanceledException)
        {
            _ok = false;
            _message = L["Stopped. Nothing was added."];
        }
        finally
        {
            _busy = false;
            _cts.Dispose();
            _cts = null;
        }
    }

    private Task CloseAsync()
    {
        if (_busy)
        {
            _cts?.Cancel();
            return Task.CompletedTask;
        }
        return OnClose.InvokeAsync();
    }
}
