@page "/downloads"
@implements IDisposable
@inject DownloadSession Session
@inject OsuLibrary Library
@inject LazerImportService Importer

<div class="downloads-page">
<div class="panel-head">
    <h1>@L["Downloads"]</h1>
    <button class="btn small" @onclick="() => ShellLauncher.OpenFolder(Session.Destination ?? Session.DownloadsDirectory)">@L["Open folder"]</button>
</div>
<p class="muted">
    @L["Downloads the maps you selected. Maps you already have are skipped, and a stopped download continues where it left off."]
</p>

@if (Session.Items.Length == 0)
{
    <div class="callout warn">@L["Nothing queued."] <a href="beatmaps">@L["Pick maps to download"]</a></div>
}
else
{
    var total = Session.Items.Length;
    var downloaded = Session.Count(DownloadItemState.Downloaded);
    var skipped = Session.Count(DownloadItemState.Skipped);
    var failed = Session.Count(DownloadItemState.Failed);

    <section class="panel">
        <div class="panel-head">
            <h2>@L[Session.IsRunning ? "Downloading" : "Finished"] <small class="muted">@Session.Completed / @total</small></h2>
            <div class="actions">
                @if (Session.IsRunning)
                {
                    <span class="spinner"></span>
                    <button class="btn" @onclick="Session.Cancel">@L["Cancel"]</button>
                }
                else if (failed > 0)
                {
                    <button class="btn" @onclick="Session.RetryFailed">@L.F("Retry {0} failed", failed)</button>
                }
            </div>
        </div>
        <div class="progress"><div style="width:@Percent(Session.Completed, total)"></div></div>
        <div class="stats">
            <div class="stat"><b>@downloaded</b><span>@L["downloaded"]</span></div>
            <div class="stat"><b>@skipped</b><span>@L["already had"]</span></div>
            <div class="stat"><b class="@(failed > 0 ? "error-text" : "")">@failed</b><span>@L["failed"]</span></div>
            <div class="stat"><b>@(total - Session.Completed)</b><span>@L["remaining"]</span></div>
        </div>
        @if (Session.Error is not null)
        {
            <div class="callout warn">@Session.Error</div>
        }
    </section>

    @if (failed > 0)
    {
        <section class="panel">
            <h2>@L["Failures"]</h2>
            <table class="table">
                <tbody>
                    @foreach (var item in Session.Items.Where(i => i.State == DownloadItemState.Failed))
                    {
                        <tr>
                            <td class="num"><a href="" @onclick="() => OpenSet(item.SetId)" @onclick:preventDefault>@item.SetId</a></td>
                            <td>@item.Artist – @item.Title</td>
                            <td class="errors">
                                @foreach (var error in (item.Detail ?? L["no mirror is enabled"]).Split("; "))
                                {
                                    <div>@error</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <section class="panel">
        <h2>@L["Mirrors"]</h2>
        @if (Session.MirrorStats.Count == 0)
        {
            <p class="muted">@L["No mirror has been tried yet."]</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>@L["Mirror"]</th><th class="num">OK</th><th class="num">@L["Failed"]</th><th class="num">@L["In a row"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var (name, stats) in Session.MirrorStats.OrderBy(s => s.Key, StringComparer.Ordinal))
                    {
                        <tr>
                            <td>@name</td>
                            <td class="num">@stats.Successes</td>
                            <td class="num">@stats.Failures</td>
                            <td class="num">@stats.ConsecutiveFailures</td>
                            <td>
                                @if (stats.ConsecutiveFailures >= Session.DisableMirrorAfter)
                                {
                                    <span class="tag failed">@L["skipped until restart"]</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <h2>@L["Queue"]</h2>
        <div class="dl-list">
            <Virtualize Items="Session.Items" ItemSize="34" Context="item">
                <div class="dl-row">
                    <span class="tag @StateClass(item.State)">@StateLabel(item.State)</span>
                    <span class="dl-name">@item.Artist – @item.Title</span>
                    <span class="muted dl-detail">@(item.State == DownloadItemState.Downloaded ? item.Detail : "")</span>
                </div>
            </Virtualize>
        </div>
    </section>
}

@if (_folder.Length > 0)
{
    var waiting = _folder.Count(a => !a.InGame);
    <section class="panel">
        <h2>@L["In the downloads folder"] <small class="muted">@L.F(_folder.Length == 1 ? "{0} file · {1} not in osu! yet" : "{0} files · {1} not in osu! yet", _folder.Length, waiting)</small></h2>
        <p class="muted small-text">
            @L["Every map downloaded so far, including earlier sessions, until it is imported or moved."]
            @if (Library.Client == OsuClient.Lazer)
            {
                @(" " + L["osu!lazer deletes each file from here once it has imported it."])
            }
        </p>
        <div class="dl-list">
            <Virtualize Items="_folder" ItemSize="34" Context="archive">
                <div class="dl-row">
                    @if (archive.InGame)
                    {
                        <span class="tag have">@L["in osu!"]</span>
                    }
                    else
                    {
                        <span class="tag downloaded-only">@L["to import"]</span>
                    }
                    <span class="dl-name" title="@archive.Path">@archive.Name</span>
                    <span class="muted dl-detail">@Format.Megabytes(archive.Size) · @archive.Modified.ToString("g", L.Culture)</span>
                </div>
            </Virtualize>
        </div>
    </section>
}

@if (Library.Client == OsuClient.Lazer)
{
    <section class="panel">
        <h2>@L["Add to osu!lazer"]</h2>
        <p class="muted">
            @L["osu!lazer keeps its maps in its own database, which Beatmap Harvest never changes. Instead, the maps are handed to osu!lazer, which imports them itself (it opens if it is closed)."]
        </p>
        <div class="actions">
            @if (Importer.IsRunning)
            {
                <span class="spinner"></span>
                <span>@Importer.Status</span>
                <button class="btn" @onclick="() => _importCts?.Cancel()">@L["Stop"]</button>
            }
            else
            {
                <button class="btn primary" disabled="@(_pending is not { Count: > 0 } || Session.IsRunning)" @onclick="ImportAsync">
                    @L.F(_pending?.Count == 1 ? "Import {0} map into osu!lazer" : "Import {0} maps into osu!lazer", _pending?.Count ?? 0)
                </button>
                <button class="btn" @onclick="() => ShellLauncher.OpenFolder(Session.DownloadsDirectory)">@L["Open downloads folder"]</button>
            }
        </div>
        @if (Importer.IsRunning || Importer.Sent > 0)
        {
            <div class="progress-row spaced-top">
                <div class="progress"><div style="width:@Format.Percent(Importer.Total == 0 ? 0 : (double)Importer.Sent / Importer.Total)"></div></div>
                <b>@Importer.Sent/@Importer.Total</b>
            </div>
        }
        @if (!Importer.IsRunning && Importer.Status is not null && Importer.Error is null)
        {
            <div class="callout ok">@Importer.Status</div>
        }
        @if (Importer.Error is not null)
        {
            <div class="callout error">@Importer.Error</div>
        }
        <p class="muted small-text">@L["Maps already in osu!lazer are left out. You can also drag the files from the downloads folder onto the osu!lazer window."]</p>
    </section>
}
else
{
<section class="panel">
    <h2>@L["Move downloads"]</h2>
    <p class="muted">
        @L["Moves the downloaded maps into osu!, which adds them the next time it starts."]
        <a href="settings">@L["The destination can be changed in Settings."]</a>
    </p>
    @if (_confirmMove)
    {
        <div class="callout warn">
            @L["Move every .osz from"] <code>@Session.DownloadsDirectory</code> @L["to"] <code>@Session.MoveToDirectory</code>?
            <div class="actions">
                <button class="btn primary" disabled="@_moving" @onclick="MoveAsync">@L["Move"]</button>
                <button class="btn" disabled="@_moving" @onclick="() => _confirmMove = false">@L["Cancel"]</button>
                @if (_moving) { <span class="spinner"></span> }
            </div>
        </div>
    }
    else
    {
        <button class="btn" disabled="@Session.IsRunning" @onclick="() => { _confirmMove = true; _moveMessage = null; }">@L["Move downloads…"]</button>
    }
    @if (_moveMessage is not null)
    {
        <div class="callout @(_moveOk ? "ok" : "error")">@_moveMessage</div>
    }
</section>
}
</div>

@code {
    private bool _confirmMove;
    private bool _moving;
    private bool _moveOk;
    private string? _moveMessage;
    private IReadOnlyList<string>? _pending;
    private CancellationTokenSource? _importCts;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Importer.Changed += OnSessionChanged;
        Library.Changed += OnLibraryChanged;
        await LoadFolderAsync();
        WatchFolder();
    }

    private FileSystemWatcher? _watcher;
    private CancellationTokenSource? _reloadDelay;

    // osu!lazer deletes each .osz once it has imported it, and finished downloads are renamed from .part to .osz:
    // follow the folder so the list keeps up.
    private void WatchFolder()
    {
        var directory = Session.DownloadsDirectory;
        if (!Directory.Exists(directory))
            return;
        _watcher = new FileSystemWatcher(directory, "*.osz") { NotifyFilter = NotifyFilters.FileName };
        _watcher.Created += OnFolderChanged;
        _watcher.Deleted += OnFolderChanged;
        _watcher.Renamed += OnFolderChanged;
        _watcher.EnableRaisingEvents = true;
    }

    private void OnFolderChanged(object sender, FileSystemEventArgs e) => _ = InvokeAsync(async () =>
    {
        // Imports delete many files in a row; reload once they settle.
        _reloadDelay?.Cancel();
        _reloadDelay?.Dispose();
        var delay = _reloadDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(700, delay.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await LoadFolderAsync();
        StateHasChanged();
    });

    private DownloadedArchive[] _folder = [];

    /// <summary>What is in the downloads folder, and (for osu!lazer) which of those files still need importing.</summary>
    private async Task LoadFolderAsync()
    {
        var snapshot = await Library.GetAsync();
        var directory = Session.DownloadsDirectory;
        _folder = (await Task.Run(() => DownloadsFolder.List(directory, snapshot.Ownership.InGame))).ToArray();
        if (Library.Client == OsuClient.Lazer && !Importer.IsRunning)
            _pending = await Importer.PendingAsync();
    }

    private async Task ImportAsync()
    {
        if (_pending is not { Count: > 0 } pending)
            return;
        _importCts = new CancellationTokenSource();
        try
        {
            await Importer.ImportAsync(pending, _importCts.Token);
        }
        finally
        {
            _importCts.Dispose();
            _importCts = null;
        }
    }

    // Finished downloads add files to import; an import changes what is already in lazer.
    private void OnLibraryChanged() => _ = InvokeAsync(async () =>
    {
        await LoadFolderAsync();
        StateHasChanged();
    });

    private async Task MoveAsync()
    {
        _moving = true;
        try
        {
            var result = await Session.MoveToSongsAsync();
            _moveOk = true;
            _moveMessage = result.Moved == 0 && result.AlreadyThere == 0
                ? L["There were no .osz files to move."]
                : L.F(result.Moved == 1 ? "Moved {0} map." : "Moved {0} maps.", result.Moved)
                  + (result.AlreadyThere > 0 ? " " + L.F("{0} were already there and were left in the downloads folder.", result.AlreadyThere) : "");
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _moveOk = false;
            _moveMessage = L.F("Could not move the files: {0}", ex.Message);
        }
        finally
        {
            _moving = false;
            _confirmMove = false;
        }
    }

    private static void OpenSet(long id) =>
        ShellLauncher.Open(string.Create(CultureInfo.InvariantCulture, $"https://osu.ppy.sh/beatmapsets/{id}"));

    private static string Percent(int part, int total) =>
        string.Create(CultureInfo.InvariantCulture, $"{(total == 0 ? 0 : 100.0 * part / total):0.#}%");

    private static string StateClass(DownloadItemState state) => state switch
    {
        DownloadItemState.Downloaded => "downloaded",
        DownloadItemState.Skipped => "skipped",
        DownloadItemState.Failed => "failed",
        _ => "queued",
    };

    private string StateLabel(DownloadItemState state) => L[state switch
    {
        DownloadItemState.Queued => "queued",
        DownloadItemState.Downloaded => "done",
        DownloadItemState.Skipped => "had it",
        DownloadItemState.Failed => "failed",
        _ => state.ToString(),
    }];

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Importer.Changed -= OnSessionChanged;
        Library.Changed -= OnLibraryChanged;
        _watcher?.Dispose();
        _reloadDelay?.Cancel();
        _reloadDelay?.Dispose();
    }
}
