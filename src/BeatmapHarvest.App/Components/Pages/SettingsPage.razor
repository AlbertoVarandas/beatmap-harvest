@page "/settings"
@inject ICredentialStore Credentials
@inject IAccessTokenProvider Tokens
@inject OsuApiOptions ApiOptions
@inject SettingsStore Settings
@inject AppPaths Paths
@inject OsuLibrary Library
@inject OsuFilesHost FilesHost
@inject SetupState Setup

<h1>@L["Settings"]</h1>
@if (!Setup.HasCredentials)
{
    <div class="callout warn">@L["Welcome! Add your osu! API credentials below to start using Beatmap Harvest."]</div>
}

<section class="panel">
    <div class="field">
        <span>@L["Language"]</span>
        <div class="segmented">
            <button class="@(L.Language == AppLanguage.English ? "on" : "")" @onclick="() => L.Set(AppLanguage.English)">English</button>
            <button class="@(L.Language == AppLanguage.Portuguese ? "on" : "")" @onclick="() => L.Set(AppLanguage.Portuguese)">Português (Portugal)</button>
        </div>
    </div>
</section>

<section class="panel">
    <h2>@L["osu! API credentials"]</h2>
    <p class="muted">@L["A free key from your osu! account, needed to read profiles. The secret is stored encrypted."]</p>
    <ol class="steps">
        <li><a href="" @onclick="OpenOAuthPage" @onclick:preventDefault>@L["Open your osu! account settings"]</a> → <b>OAuth</b> → <b>New OAuth Application</b>.</li>
        <li>
            @L["Give it any name and paste this as the callback URL:"] <code>@OsuAccount.RedirectUri</code>
            <button class="btn small" @onclick="CopyCallback">@L[_copied ? "Copied" : "Copy"]</button>
        </li>
        <li>@L.Html("Click <b>Edit</b> on it and copy the <b>Client ID</b> and the <b>Client Secret</b> here.")</li>
    </ol>

    <div class="grid-2">
        <label class="field">
            <span>Client ID</span>
            <input class="input" inputmode="numeric" @bind="_clientId" @bind:event="oninput" disabled="@_busy" />
        </label>
        <label class="field">
            <span>Client secret</span>
            <input class="input" type="password" autocomplete="off" placeholder="@(_hasSaved ? L["(saved – type to replace)"] : "")"
                   @bind="_clientSecret" @bind:event="oninput" disabled="@_busy" />
        </label>
    </div>

    <div class="actions">
        <button class="btn primary" disabled="@_busy" @onclick="TestAndSaveAsync">@L["Test & save"]</button>
        @if (_hasSaved)
        {
            <button class="btn" disabled="@_busy" @onclick="Remove">@L["Remove credentials"]</button>
        }
        @if (_busy)
        {
            <span class="spinner"></span>
        }
    </div>
    @if (_credentialMessage is not null)
    {
        <div class="callout @(_credentialOk ? "ok" : "error")">@_credentialMessage</div>
    }
</section>

<AccountPanel HasCredentials="_hasSaved" />

<section class="panel">
    <h2>osu!</h2>
    @{
        var clients = OsuClients.Detect(_osu, _lazer);
        var inUse = clients.Resolve(_client);
    }
    <div class="client-list">
        <span class="tag @(clients.Lazer is null ? "" : "have")">osu!lazer @L[clients.Lazer is null ? "not found" : "found"]</span>
        <span class="tag @(clients.Stable is null ? "" : "have")">osu! (stable) @L[clients.Stable is null ? "not found" : "found"]</span>
    </div>
    <div class="field">
        <span>@L["Use"]</span>
        <div class="segmented">
            <button class="@(_client is null ? "on" : "")" @onclick="() => SetClient(null)">@L["Automatic"]</button>
            <button class="@(_client == OsuClient.Lazer ? "on" : "")" disabled="@(clients.Lazer is null)" @onclick="() => SetClient(OsuClient.Lazer)">osu!lazer</button>
            <button class="@(_client == OsuClient.Stable ? "on" : "")" disabled="@(clients.Stable is null)" @onclick="() => SetClient(OsuClient.Stable)">osu! (stable)</button>
        </div>
    </div>
    @if (clients.BothFound && _client is null)
    {
        <div class="callout warn">@L["Both are installed, so osu!lazer is used. Pick one above if you play the other."]</div>
    }
    else if (inUse is null)
    {
        <div class="callout warn">@L["No osu! found. If it is installed somewhere unusual, set its folder below."]</div>
    }

    <FolderField Label="@L["osu!lazer folder"]" Hint="@L["detected automatically"]" Value="@_lazer"
                 ValueChanged="v => SaveFolders(() => _lazer = v)" DefaultPath="@(LazerInstall.Find(null)?.DataDirectory ?? LazerInstall.DefaultDataDirectory)" />
    <FolderField Label="@L["osu! (stable) folder"]" Hint="@L["detected automatically"]" Value="@_osu"
                 ValueChanged="v => SaveFolders(() => _osu = v)" DefaultPath="@(OsuInstall.Find(null)?.Root ?? OsuInstall.DefaultRoot)" />
    @if (inUse == OsuClient.Stable)
    {
        <FolderField Label="@L["Songs folder"]" Value="@_songs"
                     ValueChanged="v => SaveFolders(() => _songs = v)" DefaultPath="@DetectedSongs" />
    }
</section>

<section class="panel">
    <h2>@L["Downloads"]</h2>
    <FolderField Label="@L["Downloads folder"]" Value="@_downloads"
                 ValueChanged="v => SaveFolders(() => _downloads = v)" DefaultPath="@Paths.DefaultDownloadsDirectory" />
    @if (inUse == OsuClient.Stable)
    {
        <FolderField Label="@L["Move downloads to"]" Hint="@L["default: the Songs folder"]" Value="@_moveTo"
                     ValueChanged="v => SaveFolders(() => _moveTo = v)" DefaultPath="@(_songs ?? DetectedSongs)" />
    }
    <label class="field narrow">
        <span>@L["Parallel downloads"]</span>
        <input class="input" type="number" min="1" max="6" @bind="_parallel" @bind:after="() => SaveFolders(() => { })" />
    </label>
    <div class="actions">
        <button class="btn" @onclick="() => ShellLauncher.OpenFolder(Paths.Root)">@L["Open data folder"]</button>
    </div>
</section>

@code {
    [Inject(Key = ServiceRegistration.OsuHttp)]
    private HttpClient OsuHttp { get; set; } = default!;

    private string _clientId = "";
    private string _clientSecret = "";
    private bool _hasSaved;
    private bool _busy;
    private bool _credentialOk;
    private string? _credentialMessage;

    private string? _downloads;
    private string? _osu;
    private string? _songs;
    private string? _moveTo;

    private string? _lazer;
    private OsuClient? _client;

    private string DetectedSongs => OsuInstall.Find(_osu)?.SongsDirectory ?? AppPaths.DefaultSongsDirectory;
    private int _parallel;

    protected override void OnInitialized()
    {
        var saved = Credentials.Load();
        _hasSaved = saved is not null;
        _clientId = saved?.ClientId.ToString(CultureInfo.InvariantCulture) ?? "";

        var settings = Settings.Load();
        _downloads = settings.DownloadsDirectory;
        _osu = settings.OsuDirectory;
        _lazer = settings.LazerDirectory;
        _client = settings.Client;
        _songs = settings.SongsDirectory;
        _moveTo = settings.MoveToDirectory;
        _parallel = settings.MaxParallelDownloads;
    }

    private bool _copied;

    private void CopyCallback()
    {
        ClipboardHelper.Copy(OsuAccount.RedirectUri.ToString());
        _copied = true;
    }

    private void OpenOAuthPage() => ShellLauncher.Open("https://osu.ppy.sh/home/account/edit#oauth");

    private async Task TestAndSaveAsync()
    {
        _credentialMessage = null;
        if (!int.TryParse(_clientId.Trim(), NumberStyles.None, CultureInfo.InvariantCulture, out var id) || id <= 0)
        {
            Fail("The client id is a number.");
            return;
        }

        // An empty secret field keeps the saved secret (it is never shown back).
        var secret = _clientSecret.Trim();
        if (secret.Length == 0 && Credentials.Load() is { } saved && saved.ClientId == id)
            secret = saved.ClientSecret;
        if (secret.Length == 0)
        {
            Fail("Paste the client secret.");
            return;
        }

        _busy = true;
        try
        {
            var credentials = new OsuCredentials(id, secret);
            await OsuTokenProvider.VerifyAsync(OsuHttp, credentials, ApiOptions.BaseAddress, CancellationToken.None);

            Credentials.Save(credentials);
            Tokens.Invalidate();
            Setup.Refresh();
            _hasSaved = true;
            _clientSecret = "";
            _credentialOk = true;
            _credentialMessage = L["Connected to the osu! API. Credentials saved."];
        }
        catch (OsuApiException ex)
        {
            Fail(ex.Message);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Fail(L.F("Could not reach osu.ppy.sh: {0}", ex.Message));
        }
        finally
        {
            _busy = false;
        }
    }

    private void Remove()
    {
        Credentials.Clear();
        Tokens.Invalidate();
        Setup.Refresh();
        _hasSaved = false;
        _clientId = "";
        _clientSecret = "";
        _credentialOk = true;
        _credentialMessage = L["Credentials removed."];
    }

    private void Fail(string message)
    {
        _credentialOk = false;
        // Fixed English messages (ours or osu!'s) are translated; anything else is shown as is.
        _credentialMessage = L[message];
    }

    private void SetClient(OsuClient? client) => SaveFolders(() => _client = client);

    /// <summary>Applies one change and saves every osu!/download setting right away.</summary>
    private void SaveFolders(Action change)
    {
        change();
        _parallel = Math.Clamp(_parallel, 1, 6);
        Settings.Save(Settings.Load() with
        {
            Client = _client,
            DownloadsDirectory = _downloads,
            OsuDirectory = _osu,
            LazerDirectory = _lazer,
            SongsDirectory = _songs,
            MoveToDirectory = _moveTo,
            MaxParallelDownloads = _parallel,
        });
        Library.Reload();
        FilesHost.Refresh();
    }
}
