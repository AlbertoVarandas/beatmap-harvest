@page "/beatmaps"
@page "/beatmaps/{UserId:long}"
@page "/select"
@using System.Text.Json
@using BeatmapHarvest.Core.Json
@implements IDisposable
@inject HarvestSession Harvest
@inject ProfileLibrary Profiles
@inject SelectorState State
@inject DownloadSession Downloads
@inject OsuLibrary Library
@inject SettingsStore Settings
@inject AppPaths Paths
@inject NavigationManager Nav

<div class="beatmaps-page">
<h1>@L["Beatmaps"]</h1>

<HarvestPanel />

@if (_result is not null)
{
    <div class="profile-head">
        <h2>@_result.Username <small class="muted">@L.F("harvested {0:g}", _result.HarvestedAt.ToLocalTime())</small></h2>
        <div class="segmented">
            <button class="@(_tab == BeatmapsTab.Overview ? "on" : "")" @onclick="() => _tab = BeatmapsTab.Overview">@L["Overview"]</button>
            <button class="@(_tab == BeatmapsTab.Maps ? "on" : "")" @onclick="() => _tab = BeatmapsTab.Maps">@L["Maps"]</button>
        </div>
        <div class="actions push-right">
            @if (_tab == BeatmapsTab.Maps)
            {
                <button class="btn small" @onclick="SaveConfig">@L["Save selection…"]</button>
                <button class="btn small" @onclick="LoadConfig">@L["Load selection…"]</button>
            }
            <button class="btn small" @onclick="() => _confirmRemove = true">@L["Remove profile…"]</button>
        </div>
    </div>

    @if (_confirmRemove)
    {
        <div class="callout warn">
            @L.F("Remove {0}? Its list is deleted; downloaded maps stay where they are.", _result.Username)
            <div class="actions">
                <button class="btn primary" @onclick="RemoveProfile">@L["Remove"]</button>
                <button class="btn" @onclick="() => _confirmRemove = false">@L["Cancel"]</button>
            </div>
        </div>
    }
}

@if (_result is null)
{
    @if (UserId is not null)
    {
        <div class="callout warn">@L["This profile has not been harvested yet, or was removed."]</div>
    }
    else if (!Harvest.IsRunning)
    {
        <p class="muted">@L["Harvest a profile to see its beatmaps."]</p>
    }
}
else if (_tab == BeatmapsTab.Overview)
{
    <section class="panel">
        <ProfileOverview Summary="_summary!" Owned="id => _owned?.Owns(id) == true" />
    </section>
}
else if (_owned is null)
{
    <div class="actions"><span class="spinner"></span> @L["Checking which maps you already have…"]</div>
}
else
{
    <p class="muted">
        @L.F("{0} beatmapsets · {1} in osu! · {2} downloaded.", _mapsets.Count, _inGameCount, _ownedCount - _inGameCount)
        @L[Config.SelectionMode == SelectionMode.Filters ? "Click a map to add or remove it." : "Click the maps you want."]
    </p>

    @if (_message is not null)
    {
        <div class="callout @(_messageOk ? "ok" : "error")">@_message</div>
    }

    <section class="panel filters">
        <div class="filter-row">
            <div class="segmented">
                <button class="@(Config.SelectionMode == SelectionMode.Filters ? "on" : "")" @onclick="() => SwitchMode(SelectionMode.Filters)">@L["By filters"]</button>
                <button class="@(Config.SelectionMode == SelectionMode.Custom ? "on" : "")" @onclick="() => SwitchMode(SelectionMode.Custom)">@L["Hand-picked"]</button>
            </div>
            @if (Config.SelectionMode == SelectionMode.Custom)
            {
                <button class="btn small" @onclick="SelectShown">@L["Select all shown"]</button>
                <button class="btn small" disabled="@(Config.Included.Count == 0)" @onclick="ClearManual">@L["Clear"]</button>
            }
            else
            {
                <button class="btn small" disabled="@(Config.Included.Count + Config.Excluded.Count == 0)" @onclick="ClearManual">
                    @L.F("Reset hand-picked changes ({0})", Config.Included.Count + Config.Excluded.Count)
                </button>
            }
            <label class="inline-field">
                @L["Sort"]
                <select class="input small" @bind="Config.Sort" @bind:after="Refresh">
                    @foreach (var sort in MapsetSort.All)
                    {
                        <option value="@sort">@SortLabel(sort)</option>
                    }
                </select>
            </label>
        </div>

        <div class="filter-row">
            <span class="filter-label">@L["Mode"]</span>
            <div class="chips">
                @foreach (var mode in Ruleset.All)
                {
                    <span class="chip mode-@mode @(Filters.Modes.Contains(mode) ? "on" : "")" @onclick="() => ToggleIn(Filters.Modes, mode)">
                        @Format.Mode(mode) <small>@_modeCounts.GetValueOrDefault(mode)</small>
                    </span>
                }
            </div>
            @if (Filters.Modes.Count == 0) { <small class="muted">@L["all modes"]</small> }
        </div>

        <div class="grid-3">
            <div class="range-field">
                <span class="filter-label">@L["Stars"] <b>@StarsLabel()</b></span>
                <div class="dual-range">
                    <input type="range" min="0" max="10" step="0.1" @bind="_starsLo" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplyRanges" />
                    <input type="range" min="0" max="10" step="0.1" @bind="_starsHi" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplyRanges" />
                </div>
            </div>
            <div class="range-field">
                <span class="filter-label">@L["Length"] <b>@LengthLabel()</b></span>
                <div class="dual-range">
                    <input type="range" min="0" max="600" step="5" @bind="_lengthLo" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplyRanges" />
                    <input type="range" min="0" max="600" step="5" @bind="_lengthHi" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplyRanges" />
                </div>
            </div>
            <div class="range-field">
                <span class="filter-label">@L["Plays"] <small class="muted">@L["(per difficulty)"]</small></span>
                <div class="pair">
                    <input class="input small" type="number" min="0" placeholder="@L["min"]" @bind="_playsMin" @bind:after="ApplyRanges" />
                    <span class="muted">–</span>
                    <input class="input small" type="number" min="0" placeholder="@L["max"]" @bind="_playsMax" @bind:after="ApplyRanges" />
                </div>
            </div>
        </div>

        <div class="filter-row">
            <span class="filter-label">@L["Status"]</span>
            <div class="chips">
                @foreach (var status in _statuses)
                {
                    <span class="chip @(Filters.Statuses.Contains(status) ? "on" : "")" @onclick="() => ToggleIn(Filters.Statuses, status)">@Format.Status(status)</span>
                }
            </div>
        </div>

        <div class="filter-row">
            <span class="filter-label">@L["Found in"]</span>
            <div class="chips">
                @foreach (var source in Sources)
                {
                    <span class="chip @(Filters.Sources.Contains(source) ? "on" : "")" @onclick="() => ToggleIn(Filters.Sources, source)">@SourceLabel(source)</span>
                }
            </div>
        </div>

        <div class="filter-row">
            <span class="filter-label">@L["Library"]</span>
            <div class="chips">
                @foreach (var (state, label) in LibraryStates)
                {
                    <span class="chip @(Filters.Library.Contains(state) ? "on" : "")" @onclick="() => ToggleLibrary(state)">@L[label]</span>
                }
            </div>
            <small class="muted">@L[Filters.Library.Count == 0 ? "any — \"Skip maps I already have\" decides" : "only these; \"Skip maps I already have\" is ignored"]</small>
        </div>

        <div class="filter-row">
            <input class="input search" placeholder="@L["Search artist, title, mapper or difficulty"]"
                   @bind="Filters.Search" @bind:event="oninput" @bind:after="Refresh" />
            <label class="check-field">
                <input type="checkbox" @bind="Filters.SkipOwned" @bind:after="Refresh" /> @L["Skip maps I already have"]
            </label>
            <label class="check-field">
                <input type="checkbox" @bind="Filters.OnlySelected" @bind:after="Refresh" /> @L["Show only selected"]
            </label>
            <span class="inline-field" title="@L["Maps and difficulties that don't pass the filters"]">
                @L["Outside the filters"]
                <span class="segmented small">
                    <button class="@(Filters.HideUnmatched ? "" : "on")" @onclick="() => SetHideUnmatched(false)">@L["Dim"]</button>
                    <button class="@(Filters.HideUnmatched ? "on" : "")" @onclick="() => SetHideUnmatched(true)">@L["Hide"]</button>
                </span>
            </span>
        </div>
    </section>

    <div class="list-head muted">@L.F("Showing {0} of {1}", _visible.Count, _mapsets.Count)</div>

    <div class="map-list">
        <Virtualize Items="_visible" ItemSize="96" Context="m">
            @{
                var ownership = _owned.Of(m.Id);
                var selected = SelectionEngine.IsSelected(m, Config, ownership);
            }
            <div class="map-row" @key="m.Id">
                <div class="map-card @(selected ? "selected" : "")" title="@L[selected ? "Click to remove from the selection" : "Click to add to the selection"]" @onclick="() => Toggle(m)">
                    <div class="cover @(_playing == m.Id ? "playing" : "")" title="@L["Play preview"]" @onclick="() => TogglePreview(m)" @onclick:stopPropagation>
                        @if (m.Cover is not null)
                        {
                            @* Old maps may have no cover: hide the broken-image icon and keep the plain background. *@
                            <img src="@m.Cover" alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                        }
                        @if (m.Preview is not null)
                        {
                            <span class="play">@(_playing == m.Id ? "■" : "▶")</span>
                        }
                    </div>
                    <div class="map-body">
                        <div class="map-title"><b>@m.Title</b> <span class="muted">@L.F("by {0}", m.Artist)</span></div>
                        <div class="map-meta">
                            <span class="tag status-@(m.Status ?? "unknown")">@Format.Status(m.Status)</span>
                            @if (ownership == MapOwnership.InGame)
                            {
                                <span class="tag have" title="@L["Already in osu!"]">@L["In osu!"]</span>
                            }
                            else if (ownership == MapOwnership.Downloaded)
                            {
                                <span class="tag downloaded-only" title="@L["Downloaded by Beatmap Harvest, not in osu! yet"]">@L["Downloaded"]</span>
                            }
                            <span>@L.F("mapped by {0}", m.Creator)</span>
                            <span>@Format.Length(m.LengthSeconds)</span>
                            @if (m.TotalPlays > 0)
                            {
                                <span>@L.F("{0} plays", m.TotalPlays)</span>
                            }
                        </div>
                        <div class="diffs">
                            @foreach (var d in ShownDifficulties(m))
                            {
                                <span class="diff @(SelectionEngine.MatchesDifficulty(d, Filters) ? "" : "dim")"
                                      style="background:@StarColor.For(d.Stars);color:@StarColor.TextFor(d.Stars)"
                                      title="@DiffTitle(d)">
                                    <i class="dot mode-@d.Mode"></i>@Format.Stars(d.Stars)★
                                </span>
                            }
                        </div>
                    </div>
                    <button class="info-btn" title="@L["Details"]" @onclick="() => ShowDetails(m)" @onclick:stopPropagation>i</button>
                    <div class="check">@(selected ? "✓" : "")</div>
                </div>
            </div>
        </Virtualize>
    </div>

    <footer class="page-footer">
        <div class="footer-stats">
            <span><b>@_selected.Count</b> @L[_selected.Count == 1 ? "map" : "maps"]</span>
            <span><b>@_selectedDifficulties</b> @L["difficulties"]</span>
            <span><b>@Format.Duration(_selectedLength)</b> @L["of music"]</span>
        </div>
        @if (Downloads.IsRunning)
        {
            <a href="downloads">@L["A download is running…"]</a>
        }
        @if (Library.Client == OsuClient.Stable)
        {
            <button class="btn" disabled="@(_selected.Count == 0)" @onclick="() => _addToCollection = true">@L["Add to collection…"]</button>
        }
        <button class="btn primary" disabled="@(_selected.Count == 0 || Downloads.IsRunning)" @onclick="StartDownload">
            @L.F(_selected.Count == 1 ? "Download {0} map" : "Download {0} maps", _selected.Count)
        </button>
    </footer>

    @if (_previewUrl is not null)
    {
        <audio @key="_previewUrl" src="@_previewUrl" autoplay @onended="StopPreview"></audio>
    }

    @if (_addToCollection)
    {
        <AddToCollectionDialog Mapsets="_selected" OnClose="() => _addToCollection = false" />
    }

    @if (_details is not null)
    {
        <MapDetailsDialog Mapset="_details" Owned="_owned.Owns(_details.Id)" OnClose="() => _details = null" />
    }
}
</div>

@code {
    private static readonly SliderRange StarsTrack = new(0, 10);
    private static readonly SliderRange LengthTrack = new(0, 600);
    private static readonly string[] Sources =
        [HarvestSource.Best, HarvestSource.Firsts, HarvestSource.Pinned, HarvestSource.Recent, HarvestSource.MostPlayed];
    private static readonly (MapOwnership State, string Label)[] LibraryStates =
        [(MapOwnership.None, "not on this PC"), (MapOwnership.Downloaded, "downloaded, not in osu!"), (MapOwnership.InGame, "in osu!")];
    private static readonly string[] StatusOrder = ["ranked", "approved", "qualified", "loved", "pending", "wip", "graveyard"];

    private HarvestResult? _result;
    private IReadOnlyList<MapsetInfo> _mapsets = [];
    private OwnershipIndex? _owned;
    private int _ownedCount;
    private int _inGameCount;
    private Dictionary<string, int> _modeCounts = [];
    private List<string> _statuses = [];

    private List<MapsetInfo> _visible = [];
    private List<MapsetInfo> _selected = [];
    private int _selectedDifficulties;
    private TimeSpan _selectedLength;

    private double _starsLo, _starsHi, _lengthLo, _lengthHi;
    private int? _playsMin, _playsMax;

    private long? _playing;
    private MapsetInfo? _details;
    private bool _addToCollection;
    private string? _previewUrl;
    private string? _message;
    private bool _messageOk;

    private bool _confirmRemove;

    private enum BeatmapsTab
    {
        Overview,
        Maps,
    }

    private BeatmapsTab _tab = BeatmapsTab.Maps;
    private HarvestSummary? _summary;

    /// <summary>The profile to show; none = the last harvested one.</summary>
    [Parameter] public long? UserId { get; set; }

    // Each profile keeps its own selection.
    private SelectorConfig Config => _config!;
    private SelectionFilters Filters => _config!.Filters;
    private SelectorConfig? _config;

    protected override void OnInitialized()
    {
        Harvest.Changed += OnSessionChanged;
        Harvest.Completed += OnHarvestCompleted;
        Downloads.Changed += OnSessionChanged;
        Library.Changed += OnLibraryChanged;
        Harvest.LoadLatest();
    }

    // A finished harvest opens that profile's overview.
    private void OnHarvestCompleted(HarvestResult result) => _ = InvokeAsync(() =>
    {
        _tab = BeatmapsTab.Overview;
        Nav.NavigateTo(string.Create(CultureInfo.InvariantCulture, $"beatmaps/{result.UserId}"));
    });

    protected override async Task OnParametersSetAsync()
    {
        var target = Target();
        if (!ReferenceEquals(target, _result) || _owned is null)
        {
            _confirmRemove = false;
            _message = null;
            StopPreview();
            await LoadHarvestAsync(target);
        }
    }

    private HarvestResult? Target() =>
        UserId is { } id ? Profiles.Get(id) : Harvest.Current ?? Profiles.Latest;

    private async Task LoadHarvestAsync(HarvestResult? target)
    {
        _result = target;
        _owned = null;
        if (_result is null)
            return;
        _config = State.For(_result.UserId);

        _mapsets = _result.Mapsets;
        _summary = HarvestSummary.From(_mapsets);
        _modeCounts = Ruleset.All.ToDictionary(mode => mode, mode => _mapsets.Count(m => m.Difficulties.Any(d => d.Mode == mode)));
        _statuses = _mapsets.Select(m => m.Status ?? "").Where(s => s.Length > 0).Distinct()
            .OrderBy(s => Array.IndexOf(StatusOrder, s) is var i and >= 0 ? i : int.MaxValue).ThenBy(s => s, StringComparer.Ordinal)
            .ToList();
        SyncInputs();

        _owned = null;
        var library = await Library.GetAsync();
        _owned = library.Ownership;
        if (library.Error is not null)
            Show(false, library.Error);
        _ownedCount = _mapsets.Count(m => _owned.Owns(m.Id));
        _inGameCount = _mapsets.Count(m => _owned.Of(m.Id) == MapOwnership.InGame);
        Refresh();
    }

    /// <summary>Recomputes the shown list and the selection totals.</summary>
    private void Refresh()
    {
        if (_owned is null)
            return;

        IEnumerable<MapsetInfo> shown = _mapsets;
        if (Filters.OnlySelected)
            shown = shown.Where(IsSelected);
        else if (Config.SelectionMode == SelectionMode.Custom)
            shown = shown.Where(m => SelectionEngine.Matches(m, Filters, _owned.Of(m.Id)));
        else if (Filters.HideUnmatched)
            // Keep maps added by hand, and matching maps removed by hand so they can be added back.
            shown = shown.Where(m => Config.Included.Contains(m.Id) || SelectionEngine.Matches(m, Filters, _owned.Of(m.Id)));
        shown = shown.Where(m => SelectionEngine.MatchesSearch(m, Filters.Search));
        _visible = MapsetSort.Apply(shown, Config.Sort).ToList();
        UpdateTotals();
    }

    private void UpdateTotals()
    {
        var ids = SelectionEngine.SelectedIds(_mapsets, Config, _owned!).ToHashSet();
        _selected = _mapsets.Where(m => ids.Contains(m.Id)).ToList();
        var summary = HarvestSummary.From(_selected, top: 0);
        _selectedDifficulties = summary.Difficulties;
        _selectedLength = summary.TotalSongLength;
    }

    private bool IsSelected(MapsetInfo m) => SelectionEngine.IsSelected(m, Config, _owned!.Of(m.Id));

    private void ToggleLibrary(MapOwnership state)
    {
        if (!Filters.Library.Remove(state))
            Filters.Library.Add(state);
        Refresh();
    }

    private void SetHideUnmatched(bool hide)
    {
        Filters.HideUnmatched = hide;
        Refresh();
    }

    /// <summary>All difficulties, or only the matching ones in "Hide" mode (all of them if none match, e.g. a map added by hand).</summary>
    private IEnumerable<DifficultyInfo> ShownDifficulties(MapsetInfo m)
    {
        var ordered = m.Difficulties.OrderBy(d => d.Mode, StringComparer.Ordinal).ThenBy(d => d.Stars);
        if (!Filters.HideUnmatched)
            return ordered;
        var matching = ordered.Where(d => SelectionEngine.MatchesDifficulty(d, Filters)).ToList();
        return matching.Count > 0 ? matching : ordered;
    }

    // Does not re-filter the list, so a map does not vanish from under the cursor with "Show only selected".
    private void Toggle(MapsetInfo m)
    {
        SelectionEngine.Toggle(m, Config, _owned!.Of(m.Id));
        UpdateTotals();
    }

    private void SwitchMode(SelectionMode mode)
    {
        SelectionEngine.SwitchMode(Config, mode, _mapsets, _owned!);
        Refresh();
    }

    private void SelectShown()
    {
        Config.Included.UnionWith(_visible.Select(m => m.Id));
        UpdateTotals();
    }

    private void ClearManual()
    {
        Config.Included.Clear();
        Config.Excluded.Clear();
        Refresh();
    }

    private void ToggleIn(HashSet<string> set, string value)
    {
        if (!set.Remove(value))
            set.Add(value);
        Refresh();
    }

    private void ApplyRanges()
    {
        Filters.Stars = StarsTrack.ToRange(_starsLo, _starsHi);
        Filters.Length = LengthTrack.ToRange(_lengthLo, _lengthHi);
        Filters.Plays = new NumericRange(_playsMin, _playsMax);
        Refresh();
    }

    private void SyncInputs()
    {
        (_starsLo, _starsHi) = StarsTrack.FromRange(Filters.Stars);
        (_lengthLo, _lengthHi) = LengthTrack.FromRange(Filters.Length);
        _playsMin = Filters.Plays.Min is { } min ? (int)min : null;
        _playsMax = Filters.Plays.Max is { } max ? (int)max : null;
    }

    private string StarsLabel() => Filters.Stars == NumericRange.Any
        ? L["any"]
        : string.Create(L.Culture, $"{Filters.Stars.Min ?? 0:0.0}★ – {(Filters.Stars.Max is { } max ? string.Create(L.Culture, $"{max:0.0}★") : "10★+")}");

    private string LengthLabel() => Filters.Length == NumericRange.Any
        ? L["any"]
        : $"{Format.Length(Filters.Length.Min ?? 0)} – {(Filters.Length.Max is { } max ? Format.Length(max) : "10:00+")}";

    private void TogglePreview(MapsetInfo m)
    {
        if (_playing == m.Id || m.Preview is null)
        {
            StopPreview();
            return;
        }
        _playing = m.Id;
        _previewUrl = m.Preview;
    }

    private void StopPreview()
    {
        _playing = null;
        _previewUrl = null;
    }

    private void ShowDetails(MapsetInfo m)
    {
        StopPreview();
        _details = m;
    }

    private void StartDownload()
    {
        StopPreview();
        Downloads.Start(_selected);
        Nav.NavigateTo("downloads");
    }

    private void SaveConfig()
    {
        var path = FileDialogs.Save(L["Save selection"], $"{_result?.Username ?? "beatmaps"}-selection.json", L["Selection (*.json)|*.json|All files (*.*)|*.*"]);
        if (path is null)
            return;
        try
        {
            AtomicFile.WriteJson(path, Config);
            Show(true, L.F("Saved to {0}.", path));
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Show(false, L.F("Could not save: {0}", ex.Message));
        }
    }

    private void LoadConfig()
    {
        var path = FileDialogs.Open(L["Load selection"], L["Selection (*.json)|*.json|All files (*.*)|*.*"]);
        if (path is null)
            return;
        try
        {
            var loaded = JsonSerializer.Deserialize<SelectorConfig>(File.ReadAllText(path), JsonDefaults.Files);
            if (loaded is null || loaded.BeatmapHarvestSelector != 1)
            {
                Show(false, L["That file is not a Beatmap Harvest selection."]);
                return;
            }
            State.Set(_result!.UserId, loaded);
            _config = loaded;
            SyncInputs();
            Refresh();
            Show(true, L.F("Loaded {0}: {1} maps selected.", Path.GetFileName(path), _selected.Count));
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException)
        {
            Show(false, L.F("Could not load: {0}", ex.Message));
        }
    }

    private void Show(bool ok, string message)
    {
        _messageOk = ok;
        _message = message;
    }

    // A finished harvest may be a newer version of the profile on screen.
    private void OnSessionChanged() => _ = InvokeAsync(async () =>
    {
        if (!Harvest.IsRunning && Target() is var target && !ReferenceEquals(target, _result))
            await LoadHarvestAsync(target);
        StateHasChanged();
    });

    // New downloads or moved files change what is "already on this PC".
    private void OnLibraryChanged() => _ = InvokeAsync(async () =>
    {
        if (_result is not null)
            await LoadHarvestAsync(_result);
        StateHasChanged();
    });

    private void RemoveProfile()
    {
        if (_result is null)
            return;
        var id = _result.UserId;
        Profiles.Remove(id);
        State.Forget(id);
        Harvest.Forget(id);
        _confirmRemove = false;
        Nav.NavigateTo("beatmaps");
    }

    private string DiffTitle(DifficultyInfo d) =>
        $"{d.Version} · {Format.Mode(d.Mode)} · {Format.Stars(d.Stars)}★ · {Format.Length(d.LengthSeconds)}"
        + (d.Plays is > 0 ? " · " + L.F("{0} plays", d.Plays) : "");

    private string SortLabel(string sort) => L[sort switch
    {
        MapsetSort.Plays => "Most played",
        MapsetSort.Artist => "Artist",
        MapsetSort.Title => "Title",
        MapsetSort.Stars => "Hardest",
        MapsetSort.Length => "Longest",
        MapsetSort.Mapper => "Mapper",
        _ => sort,
    }];

    private string SourceLabel(string source) => L[source switch
    {
        HarvestSource.Best => "best scores",
        HarvestSource.Firsts => "first places",
        HarvestSource.Pinned => "pinned",
        HarvestSource.Recent => "recent",
        HarvestSource.MostPlayed => "most played",
        _ => source,
    }];

    public void Dispose()
    {
        Harvest.Changed -= OnSessionChanged;
        Harvest.Completed -= OnHarvestCompleted;
        Downloads.Changed -= OnSessionChanged;
        Library.Changed -= OnLibraryChanged;
    }
}
