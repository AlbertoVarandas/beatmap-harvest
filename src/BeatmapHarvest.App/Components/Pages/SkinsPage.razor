@page "/skins"
@implements IDisposable
@inject OsuLibrary Library
@inject LazerRealmService LazerRealm

<div class="panel-head">
    <h1>@L["Skins"] @if (_cards.Count > 0) { <small class="muted">@_cards.Count</small> }</h1>
    <div class="actions">
        @if (Library.Client == OsuClient.Lazer)
        {
            <button class="btn small" disabled="@(_lazer is null)" title="@L["Read osu!lazer's skins again, e.g. after adding some in osu!lazer"]"
                    @onclick="LazerRealm.Reload">@L["Reload from osu!lazer"]</button>
        }
        else if (_install is not null)
        {
            <button class="btn small" @onclick="() => ShellLauncher.OpenFolder(_install.SkinsDirectory)">@L["Open Skins folder"]</button>
        }
    </div>
</div>
<p class="muted">
    @L["The skins installed in osu!."]
    @if (Library.Client == OsuClient.Lazer)
    {
        @(" " + L["Read from a copy of osu!lazer's database. Change skins in osu!lazer itself."])
    }
</p>

@if (Library.Client == OsuClient.Lazer && _lazer is null)
{
    <div class="page-loader"><span class="spinner"></span> @L["Reading osu!lazer's database…"]</div>
}
else if (_lazer?.Error is not null)
{
    <div class="callout error">@_lazer.Error</div>
}
else if (Library.Client != OsuClient.Lazer && _install is null)
{
    <div class="callout warn">@L["osu! was not found on this PC."] <a href="settings">@L["Set its folder in Settings"]</a>.</div>
}
else if (_cards.Count == 0)
{
    <p class="muted empty-note">@L["No skins installed."]</p>
}
else
{
    @if (_cards.FirstOrDefault(c => c.Current) is { } current)
    {
        <h2 class="section-title">@L["In use"]</h2>
        <SkinCardView Card="current" Featured="true" />
    }

    var own = _cards.Where(c => !c.BuiltIn && !c.Current).ToList();
    @if (own.Count > 0)
    {
        <h2 class="section-title">@L["Your skins"] <small class="muted">@own.Count</small></h2>
        <div class="skins">
            @foreach (var card in own)
            {
                <SkinCardView Card="card" />
            }
        </div>
    }

    var builtIn = _cards.Where(c => c.BuiltIn && !c.Current).ToList();
    @if (builtIn.Count > 0)
    {
        <h2 class="section-title">@L["Built into osu!lazer"]</h2>
        <div class="builtin-skins">
            @foreach (var card in builtIn)
            {
                <div class="builtin-skin" title="@card.Author">
                    <b>@card.Name</b>
                    <span class="muted">@card.Author</span>
                </div>
            }
        </div>
    }
}

@code {
    private OsuInstall? _install;
    private LazerRealmResult? _lazer;
    private List<SkinCard> _cards = [];

    protected override async Task OnInitializedAsync()
    {
        if (Library.Client == OsuClient.Lazer)
        {
            LazerRealm.Changed += OnLazerChanged;
            await LoadLazerAsync();
            return;
        }
        _install = Library.Install;
        if (_install is not null)
        {
            var install = _install;
            var skins = await Task.Run(() => SkinCatalog.List(install.SkinsDirectory));
            _cards = skins.Select(s => new SkinCard(
                    s.Name, s.Author is null ? L["unknown author"] : L.F("by {0}", s.Author),
                    string.Join(" · ", new[] { s.Version is null ? null : L.F("skin version {0}", s.Version), L.F(s.Files == 1 ? "{0} file" : "{0} files", s.Files) }.OfType<string>()),
                    string.Equals(s.Folder, install.CurrentSkin, StringComparison.OrdinalIgnoreCase), false,
                    s.Previews.Select(p => (L[p.Label], OsuFilesHost.Url(Path.Combine("Skins", p.RelativePath)))).ToList(),
                    Path.Combine(install.SkinsDirectory, s.Folder)))
                .ToList();
        }
    }

    private async Task LoadLazerAsync()
    {
        var current = Library.Clients.Lazer?.CurrentSkin;
        _lazer = await LazerRealm.GetAsync();
        _cards = (_lazer.Content?.Skins ?? []).Select(s => new SkinCard(
                s.Name, s.Creator.Length == 0 ? L["unknown author"] : L.F("by {0}", s.Creator),
                s.Protected ? L["Comes with osu!lazer."] : L.F(s.Files.Count == 1 ? "{0} file" : "{0} files", s.Files.Count),
                s.Id == current, s.Protected,
                SkinCatalog.LazerPreviews(s).Select(p => (L[p.Label], OsuFilesHost.LazerUrl(p.RelativePath))).ToList(),
                null))
            .ToList();
    }

    private void OnLazerChanged() => _ = InvokeAsync(async () =>
    {
        _lazer = null;
        StateHasChanged();
        await LoadLazerAsync();
        StateHasChanged();
    });

    public void Dispose() => LazerRealm.Changed -= OnLazerChanged;
}
