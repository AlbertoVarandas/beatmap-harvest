@page "/library"
@implements IDisposable
@inject OsuLibrary Library
@inject ProfileLibrary Profiles
@inject SelectorState Selector
@inject NavigationManager Nav

<div class="panel-head">
    <h1>@L["osu! library"]</h1>
    <button class="btn small" disabled="@(_snapshot is null)" @onclick="Library.Reload">@L["Reload"]</button>
</div>
<p class="muted">@L["The maps you already have in osu!, compared with the profiles you harvested."]</p>

@if (_snapshot is null)
{
    <div class="actions"><span class="spinner"></span> @L["Reading your osu! library…"]</div>
}
else
{
    var clients = _snapshot.Clients;
    var db = _snapshot.Database;

    @if (_snapshot.Error is not null)
    {
        <div class="callout warn">@_snapshot.Error</div>
    }
    <ClientNotice Snapshot="_snapshot" />

    <section class="panel">
        <h2>@Format.Client(_snapshot.Client)</h2>
        @if (_snapshot.Client is null)
        {
            <div class="callout warn">@L["osu! was not found on this PC."] <a href="settings">@L["Set its folder in Settings"]</a>.</div>
        }
        else
        {
            <div class="detail-grid">
                <div><span>@L["Beatmapsets"]</span><b>@_sets.Count</b></div>
                <div><span>@L["Difficulties"]</span><b>@_snapshot.Maps.Count</b></div>
                @if (!string.IsNullOrEmpty(db?.PlayerName))
                {
                    <div><span>@L["Player"]</span><b>@db.PlayerName</b></div>
                }
            </div>
            <div class="actions">
                @if (_snapshot.Client == OsuClient.Lazer)
                {
                    <button class="btn small" @onclick="() => ShellLauncher.OpenFolder(clients.Lazer!.DataDirectory)">@L["Open osu!lazer folder"]</button>
                }
                else
                {
                    <button class="btn small" @onclick="() => ShellLauncher.OpenFolder(clients.Stable!.Root)">@L["Open osu! folder"]</button>
                    <button class="btn small" @onclick="() => ShellLauncher.OpenFolder(_snapshot.SongsDirectory)">@L["Open Songs folder"]</button>
                }
            </div>
        }
    </section>

    @if (_profiles.Count > 0)
    {
        <section class="panel">
            <h2>@L["Your harvests compared"]</h2>
            <table class="table">
                <thead>
                    <tr><th>@L["Profile"]</th><th class="num">@L["Beatmapsets"]</th><th class="num">@L["In osu!"]</th><th class="num">@L["Downloaded only"]</th><th class="num">@L["Missing"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _profiles)
                    {
                        <tr>
                            <td>@row.Username</td>
                            <td class="num">@row.Total</td>
                            <td class="num">@row.InGame</td>
                            <td class="num">@row.Downloaded</td>
                            <td class="num"><b>@row.Missing</b></td>
                            <td class="num"><button class="btn small" disabled="@(row.Missing == 0)" @onclick="() => ShowMissing(row.UserId)">@L["Show missing"]</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (_sets.Count > 0)
    {
        <section class="panel">
            <div class="panel-head">
                <h2>@L["Installed beatmapsets"] <small class="muted">@L.F("{0} of {1}", Shown().Count(), _sets.Count)</small></h2>
                <input class="input small" placeholder="@L["Search"]" @bind="_search" @bind:event="oninput" />
            </div>
            <div class="local-list">
                <Virtualize Items="Shown().ToList()" ItemSize="58" Context="set">
                    <div class="local-row">
                        <div class="local-cover">
                            @* Online cover first; osu! has none for some maps (e.g. removed art), so fall back to the map's own background. *@
                            @if (set.SetId > 0 || set.Background is not null)
                            {
                                <img src="@(set.SetId > 0 ? CoverUrl(set.SetId) : set.Background)" data-fallback="@(set.SetId > 0 ? set.Background : null)"
                                     alt="" loading="lazy" onerror="@ImageFallbackScript" />
                            }
                        </div>
                        <div class="local-text">
                            <div class="map-title"><b>@set.Title</b> <span class="muted">@L.F("by {0}", set.Artist)</span></div>
                            <div class="map-meta">
                                <span>@L.F("mapped by {0}", set.Creator)</span>
                                <span>@L.F(set.Difficulties == 1 ? "{0} difficulty" : "{0} difficulties", set.Difficulties)</span>
                                @foreach (var mode in set.Modes)
                                {
                                    <span><i class="dot mode-@mode"></i> @Format.Mode(mode)</span>
                                }
                                @if (set.SetId <= 0)
                                {
                                    <span class="tag">@L["not on osu! website"]</span>
                                }
                            </div>
                        </div>
                        @if (set.SetId > 0)
                        {
                            <button class="btn small" @onclick="() => ShellLauncher.Open(SetUrl(set.SetId))">@L["osu! page"]</button>
                        }
                    </div>
                </Virtualize>
            </div>
        </section>
    }
}

@code {
    /// <summary>Tries data-fallback once, then hides the image.</summary>
    private const string ImageFallbackScript =
        "if (this.dataset.fallback) { this.src = this.dataset.fallback; this.dataset.fallback = ''; } else { this.style.visibility = 'hidden'; }";

    /// <param name="Background">URL of the map's own background image in the Songs folder, if it has one.</param>
    private sealed record LocalSet(long SetId, string Artist, string Title, string Creator, int Difficulties, IReadOnlyList<string> Modes, string? Background);
    private sealed record ProfileRow(long UserId, string Username, int Total, int InGame, int Downloaded, int Missing);

    private LibrarySnapshot? _snapshot;
    private List<LocalSet> _sets = [];
    private List<ProfileRow> _profiles = [];
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        Library.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _snapshot = null;
        var snapshot = await Library.GetAsync();
        var stable = snapshot.Client == OsuClient.Stable;
        _sets = await Task.Run(() => snapshot.Maps
            .GroupBy(b => b.BeatmapsetId > 0 ? b.BeatmapsetId.ToString(CultureInfo.InvariantCulture) : "folder:" + b.FolderName, StringComparer.Ordinal)
            .Select(g =>
            {
                var first = g.First();
                return new LocalSet(first.BeatmapsetId, first.Artist, first.Title, first.Creator, g.Count(),
                    g.Select(b => b.Mode).Distinct().Order(StringComparer.Ordinal).ToList(),
                    stable ? LocalBackground(snapshot.SongsDirectory, first) : null);
            })
            .OrderBy(s => s.Artist, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(s => s.Title, StringComparer.CurrentCultureIgnoreCase)
            .ToList());

        _profiles = Profiles.Profiles
            .Select(p => Profiles.Get(p.UserId))
            .OfType<HarvestResult>()
            .Select(r =>
            {
                var states = r.Mapsets.Select(m => snapshot.Ownership.Of(m.Id)).ToList();
                return new ProfileRow(r.UserId, r.Username, states.Count,
                    states.Count(s => s == MapOwnership.InGame),
                    states.Count(s => s == MapOwnership.Downloaded),
                    states.Count(s => s == MapOwnership.None));
            })
            .ToList();
        _snapshot = snapshot;
    }

    private IEnumerable<LocalSet> Shown() => string.IsNullOrWhiteSpace(_search)
        ? _sets
        : _sets.Where(s => s.Title.Contains(_search, StringComparison.CurrentCultureIgnoreCase)
                           || s.Artist.Contains(_search, StringComparison.CurrentCultureIgnoreCase)
                           || s.Creator.Contains(_search, StringComparison.CurrentCultureIgnoreCase));

    /// <summary>Opens that profile's Beatmaps with only the maps not on this PC.</summary>
    private void ShowMissing(long userId)
    {
        var filters = Selector.For(userId).Filters;
        filters.Library.Clear();
        filters.Library.Add(MapOwnership.None);
        Nav.NavigateTo(string.Create(CultureInfo.InvariantCulture, $"beatmaps/{userId}"));
    }

    private static string? LocalBackground(string songsDirectory, LocalBeatmap map)
    {
        if (map.FolderName.Length == 0 || map.OsuFile.Length == 0)
            return null;
        var background = OsuFileReader.ReadBackground(Path.Combine(songsDirectory, map.FolderName, map.OsuFile));
        return background is null ? null : OsuFilesHost.SongsUrl(Path.Combine(map.FolderName, background));
    }

    private static string CoverUrl(long setId) =>
        string.Create(CultureInfo.InvariantCulture, $"https://assets.ppy.sh/beatmaps/{setId}/covers/list@2x.jpg");

    private static string SetUrl(long setId) =>
        string.Create(CultureInfo.InvariantCulture, $"https://osu.ppy.sh/beatmapsets/{setId}");

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        _snapshot = null;
        StateHasChanged();
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Library.Changed -= OnChanged;
}
