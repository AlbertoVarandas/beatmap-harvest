@page "/collections"
@implements IDisposable
@inject CollectionsService Collections
@inject OsuLibrary Library
@inject OsuProcessWatcher Processes
@inject LazerRealmService LazerRealm

<div class="panel-head">
    <h1>@L["Collections"]</h1>
    @if (_db is not null)
    {
        <div class="actions">
            <button class="btn" disabled="@(!Collections.IsDirty)" @onclick="Discard">@L["Discard changes"]</button>
            @* The hint sits on a wrapper: a disabled button gets no hover of its own. *@
            <span class="hint-wrap" title="@SaveBlockedReason()">
                <button class="btn primary" disabled="@(SaveBlockedReason() is not null)" @onclick="Save">@L["Save to osu!"]</button>
            </span>
        </div>
    }
</div>
<p class="muted">
    @if (_location.Target is CollectionsTarget.LazerViaStable or CollectionsTarget.LazerFolder)
    {
        @L.Html("Collections to bring into osu!lazer. Click <b>Save to osu!</b>, then import them in osu!lazer as shown below.")
    }
    else
    {
        @L.Html("Your osu! collections. Changes only reach osu! when you click <b>Save to osu!</b> (with osu! closed).")
    }
</p>

@if (_location.Target is CollectionsTarget.LazerViaStable or CollectionsTarget.LazerFolder)
{
    <section class="panel lazer-steps">
        <h2>@L["Getting them into osu!lazer"]</h2>
        <p class="muted">
            @L["osu!lazer keeps its collections in its own database, which Beatmap Harvest never changes: a mistake there could cost you your whole lazer library. Instead, the collections are saved in the classic osu! format, which osu!lazer imports itself."]
        </p>
        <ol class="steps">
            <li>@L.Html("Make your collections here and click <b>Save to osu!</b>.")</li>
            <li>@L.Html("In osu!lazer, open <b>Settings</b> and click <b>Run setup wizard</b>, then go to the step that imports from osu!stable.")</li>
            <li>
                @if (_location.Target == CollectionsTarget.LazerFolder)
                {
                    @L["As the osu!stable folder, choose:"]
                }
                else
                {
                    @L["As the osu!stable folder, keep your osu! (stable) folder:"]
                }
                <CopyText Value="@_location.Folder" />
            </li>
            <li>@L.Html("Leave only <b>Collections</b> ticked and import.")</li>
        </ol>
        <p class="muted small-text">
            @L["Maps that are not in osu!lazer yet appear in their collections as soon as you import them. Collections you made in osu!lazer itself are listed at the bottom of this page, read-only."]
        </p>
    </section>
}

@if (_error is not null)
{
    <div class="callout error">@_error</div>
}
@if (_message is not null)
{
    <div class="callout ok">@_message</div>
}

@if (_db is null)
{
    @if (_error is null)
    {
        <div class="callout warn">@L["osu! was not found on this PC."] <a href="settings">@L["Set its folder in Settings"]</a>.</div>
    }
}
else
{
    @switch (Collections.IsDirty ? Collections.SaveBlockedBy : null)
    {
        case OsuClient.Stable:
            <div class="callout warn">@L["osu! is running. Close it before saving, or it will overwrite your changes when it exits."]</div>
            break;
        case OsuClient.Lazer:
            <div class="callout warn">@L["osu!lazer is open. Close it before saving collections for it."]</div>
            break;
    }

    <section class="panel">
        <div class="folder-field">
            <input class="input" placeholder="@L["New collection name"]" @bind="_newName" @bind:event="oninput" @onkeydown="OnNewKey" />
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(_newName)" @onclick="CreateNew">@L["Create"]</button>
        </div>
    </section>

    @if (_db.Collections.Count == 0)
    {
        <p class="muted">@L["No collections yet."]</p>
    }

    @foreach (var collection in _db.Collections)
    {
        var installed = collection.Hashes.Count(h => _local.ContainsKey(h));
        var open = _open.Contains(collection);
        <section class="panel collection">
            <div class="panel-head">
                @if (_renaming == collection)
                {
                    <div class="folder-field grow">
                        <input class="input" @bind="_renameText" @bind:event="oninput" @onkeydown="e => OnRenameKey(e, collection)" />
                        <button class="btn small" @onclick="() => FinishRename(collection)">OK</button>
                    </div>
                }
                else
                {
                    <h2 class="clickable-title" @onclick="() => ToggleOpen(collection)">
                        @(open ? "▾" : "▸") @collection.Name
                        <small class="muted">@L.F("{0} difficulties · {1} in osu!", collection.Hashes.Count, installed)</small>
                    </h2>
                    <div class="actions">
                        <button class="btn small" @onclick="() => StartRename(collection)">@L["Rename"]</button>
                        @if (_confirmDelete == collection)
                        {
                            <button class="btn small primary" @onclick="() => Delete(collection)">@L["Delete"]</button>
                            <button class="btn small" @onclick="() => _confirmDelete = null">@L["Cancel"]</button>
                        }
                        else
                        {
                            <button class="btn small" @onclick="() => _confirmDelete = collection">@L["Delete…"]</button>
                        }
                    </div>
                }
            </div>
            @if (open)
            {
                <div class="dl-list">
                    @foreach (var hash in collection.Hashes.ToList())
                    {
                        <div class="dl-row">
                            @if (_local.TryGetValue(hash, out var map))
                            {
                                <span class="tag have">@L["in osu!"]</span>
                                <span class="dl-name">@map.Artist – @map.Title <span class="muted">[@map.Version]</span></span>
                            }
                            else
                            {
                                <span class="tag">@L["not in osu!"]</span>
                                <span class="dl-name muted">@L.F("Difficulty {0}… (shows up once the map is in osu!)", hash[..Math.Min(8, hash.Length)])</span>
                            }
                            <button class="btn small" @onclick="() => Collections.Remove(collection, hash)">@L["Remove"]</button>
                        </div>
                    }
                </div>
            }
        </section>
    }
}

@if (_location.Target is CollectionsTarget.LazerViaStable or CollectionsTarget.LazerFolder)
{
    <h2 class="spaced-top">@L["Already in osu!lazer"]</h2>
    <p class="muted">@L["The collections osu!lazer has now, read from a copy of its database. Change them in osu!lazer itself."]</p>
    @if (_lazer is null)
    {
        <p class="muted"><span class="spinner"></span> @L["Reading osu!lazer's database…"]</p>
    }
    else if (_lazer.Error is not null)
    {
        <div class="callout error">@_lazer.Error</div>
    }
    else if (_lazer.Content is not { Collections.Count: > 0 })
    {
        <p class="muted">@L["osu!lazer has no collections yet."]</p>
    }
    else
    {
        @foreach (var collection in _lazer.Content.Collections)
        {
            var installed = collection.Hashes.Count(h => _local.ContainsKey(h));
            var open = _openLazer.Contains(collection.Id);
            <section class="panel collection">
                <div class="panel-head">
                    <h2 class="clickable-title" @onclick="() => ToggleLazer(collection.Id)">
                        @(open ? "▾" : "▸") @collection.Name
                        <small class="muted">@L.F("{0} difficulties · {1} in osu!", collection.Hashes.Count, installed)</small>
                    </h2>
                    <span class="tag">@L["read-only"]</span>
                </div>
                @if (open)
                {
                    <div class="dl-list">
                        @foreach (var hash in collection.Hashes)
                        {
                            <div class="dl-row">
                                @if (_local.TryGetValue(hash, out var map))
                                {
                                    <span class="tag have">@L["in osu!"]</span>
                                    <span class="dl-name">@map.Artist – @map.Title <span class="muted">[@map.Version]</span></span>
                                }
                                else
                                {
                                    <span class="tag">@L["not in osu!"]</span>
                                    <span class="dl-name muted">@L.F("Difficulty {0}… (shows up once the map is in osu!)", hash[..Math.Min(8, hash.Length)])</span>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }
    }
}

@code {
    private LazerRealmResult? _lazer;
    private readonly HashSet<Guid> _openLazer = [];

    private void ToggleLazer(Guid id)
    {
        if (!_openLazer.Remove(id))
            _openLazer.Add(id);
    }

    private CollectionDatabase? _db;
    private Dictionary<string, LocalBeatmap> _local = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<OsuCollection> _open = [];
    private string _newName = "";
    private OsuCollection? _renaming;
    private string _renameText = "";
    private OsuCollection? _confirmDelete;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        Collections.Changed += OnChanged;
        Processes.Changed += OnChanged;
        try
        {
            _db = Collections.Get();
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException)
        {
            _error = L.F("Could not read collection.db: {0}", ex.Message);
        }
        var snapshot = await Library.GetAsync();
        foreach (var map in snapshot.Maps.Where(m => m.Md5.Length > 0))
            _local.TryAdd(map.Md5, map);
        if (_location.Target is CollectionsTarget.LazerViaStable or CollectionsTarget.LazerFolder)
            _lazer = await LazerRealm.GetAsync();
    }

    private CollectionsLocation _location => Collections.Location;
    /// <summary>Why "Save to osu!" can't be clicked right now (shown on hover), or null when it can.</summary>
    private string? SaveBlockedReason() => Collections.SaveBlockedBy switch
    {
        OsuClient.Stable => L["osu! is running. Close it before saving, or it will overwrite your changes when it exits."],
        OsuClient.Lazer => L["osu!lazer is open. Close it before saving collections for it."],
        _ when !Collections.IsDirty => L["Nothing to save: there are no changes."],
        _ => null,
    };

    private void CreateNew()
    {
        if (string.IsNullOrWhiteSpace(_newName))
            return;
        _open.Add(Collections.Create(_newName.Trim()));
        _newName = "";
    }

    private void OnNewKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            CreateNew();
    }

    private void ToggleOpen(OsuCollection collection)
    {
        if (!_open.Remove(collection))
            _open.Add(collection);
    }

    private void StartRename(OsuCollection collection)
    {
        _renaming = collection;
        _renameText = collection.Name;
    }

    private void FinishRename(OsuCollection collection)
    {
        if (!string.IsNullOrWhiteSpace(_renameText))
            Collections.Rename(collection, _renameText.Trim());
        _renaming = null;
    }

    private void OnRenameKey(KeyboardEventArgs e, OsuCollection collection)
    {
        if (e.Key == "Enter")
            FinishRename(collection);
        else if (e.Key == "Escape")
            _renaming = null;
    }

    private void Delete(OsuCollection collection)
    {
        Collections.Delete(collection);
        _confirmDelete = null;
    }

    private void Save()
    {
        _error = null;
        _message = null;
        try
        {
            var backup = Collections.Save();
            _message = backup is null
                ? L["Saved to osu!."]
                : L.F("Saved to osu!. The previous file was kept as {0}.", Path.GetFileName(backup));
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException)
        {
            _error = L[ex.Message];
        }
    }

    private void Discard()
    {
        Collections.Discard();
        _db = Collections.Get();
        _open.Clear();
        _message = L["Changes discarded."];
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Collections.Changed -= OnChanged;
        Processes.Changed -= OnChanged;
    }
}
