@* Tells the user when both osu! clients are installed and which one the app is using. *@
@inject SettingsStore Settings

@if (Snapshot.Clients.BothFound && Settings.Load().Client is null)
{
    <div class="callout warn">
        Both osu! and osu!lazer are installed. Using <b>@Format.Client(Snapshot.Client)</b>.
        <a href="settings">Choose another in Settings</a>.
    </div>
}

@code {
    [Parameter, EditorRequired] public LibrarySnapshot Snapshot { get; set; } = default!;
}
