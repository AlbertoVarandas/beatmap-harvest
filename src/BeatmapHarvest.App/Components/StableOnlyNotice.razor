@* Shown on tools that only work with osu! stable files (collections, skins) when the app is not using osu! stable. *@
@inject OsuLibrary Library

@if (Library.Client == OsuClient.Lazer)
{
    <div class="callout warn">
        @L[What == "skins"
            ? "osu!lazer keeps its skins inside its own database, which Beatmap Harvest can't change."
            : "osu!lazer keeps its collections inside its own database, which Beatmap Harvest can't change."]
        @if (Library.Clients.Stable is not null)
        {
            <span>@L["To use the ones from osu! (stable),"] <a href="settings">@L["switch to it in Settings"]</a>.</span>
        }
    </div>
}
else
{
    <div class="callout warn">@L["osu! was not found on this PC."] <a href="settings">@L["Set its folder in Settings"]</a>.</div>
}

@code {
    /// <summary>"collections" or "skins".</summary>
    [Parameter, EditorRequired] public string What { get; set; } = "";
}
