@inherits LayoutComponentBase
@implements IDisposable
@inject ProfileLibrary Profiles
@inject SetupState Setup
@inject OsuAccount Account
@inject NavigationManager Nav

<div class="shell">
    <nav class="sidebar">
        <div class="brand"><img src="img/icon.png" alt="" /><span class="brand-name">beatmap<span>harvest</span></span></div>

        <NavEntry Href="beatmaps" Text="@L["Beatmaps"]" Match="NavLinkMatch.All" Enabled="Setup.HasCredentials" DisabledHint="@L[NeedsCredentials]" />
        @if (Setup.HasCredentials && _profiles.Count > 0)
        {
            @* One entry per harvested profile; the signed-in user's own profile comes first, in bold. *@
            <div class="nav-sub">
                @foreach (var profile in _profiles)
                {
                    <NavLink class="@($"nav-sub-item{(IsMe(profile) ? " me" : "")}")" href="@ProfileHref(profile)" Match="NavLinkMatch.All"
                             title="@ProfileTitle(profile)">
                        <span class="nav-sub-name">@profile.Username</span>
                        <small>@profile.Mapsets</small>
                    </NavLink>
                }
            </div>
        }
        <NavEntry Href="friends" Text="@L["My friends"]" Enabled="@(Setup.HasCredentials && Account.User is not null)"
                  DisabledHint="@L[Setup.HasCredentials ? "Sign in with your osu! account in Settings" : NeedsCredentials]" />
        <NavEntry Href="downloads" Text="@L["Downloads"]" Enabled="Setup.HasCredentials" DisabledHint="@L[NeedsCredentials]" />
        <NavEntry Href="library" Text="@L["osu! library"]" Enabled="Setup.HasCredentials" DisabledHint="@L[NeedsCredentials]" />
        <NavEntry Href="collections" Text="@L["Collections"]" Enabled="Setup.HasCredentials" DisabledHint="@L[NeedsCredentials]" />
        <NavEntry Href="skins" Text="@L["Skins"]" Enabled="Setup.HasCredentials" DisabledHint="@L[NeedsCredentials]" />
        <NavEntry Href="settings" Text="@L["Settings"]" />
    </nav>
    <main class="content">
        @* Re-created when the language changes, so the page renders again in the new language. *@
        <div class="page" @key="L.Language">
            @Body
        </div>
    </main>
</div>

@code {
    private const string NeedsCredentials = "Add your osu! API credentials in Settings first";

    private IReadOnlyList<ProfileEntry> _profiles = [];

    protected override void OnInitialized()
    {
        Refresh();
        L.Changed += OnChanged;
        Profiles.Changed += OnChanged;
        Setup.Changed += OnChanged;
        Account.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void Refresh()
    {
        var me = Account.User?.UserId;
        _profiles = Profiles.Profiles
            .OrderByDescending(p => p.UserId == me)
            .ToList();
    }

    private bool IsMe(ProfileEntry profile) => Account.User?.UserId == profile.UserId;

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        Guard();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Guard();

    /// <summary>Keeps the user out of tabs that are not available yet (e.g. through a link).</summary>
    private void Guard()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        if (path.Length == 0 || path.StartsWith("settings", StringComparison.OrdinalIgnoreCase))
            return;
        if (!Setup.HasCredentials)
            Nav.NavigateTo("settings", replace: true);
        else if (path.StartsWith("friends", StringComparison.OrdinalIgnoreCase) && Account.User is null)
            Nav.NavigateTo("beatmaps", replace: true);
    }

    private static string ProfileHref(ProfileEntry profile) =>
        string.Create(CultureInfo.InvariantCulture, $"beatmaps/{profile.UserId}");

    private string ProfileTitle(ProfileEntry profile) =>
        L.F("{0} · {1} beatmapsets · harvested {2:g}", profile.Username, profile.Mapsets, profile.HarvestedAt.ToLocalTime());

    public void Dispose()
    {
        L.Changed -= OnChanged;
        Profiles.Changed -= OnChanged;
        Setup.Changed -= OnChanged;
        Account.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
