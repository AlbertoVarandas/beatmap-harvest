@inherits LayoutComponentBase
@implements IDisposable
@inject ProfileLibrary Profiles
@inject SetupState Setup
@inject OsuAccount Account
@inject NavigationManager Nav

<div class="shell">
    <nav class="sidebar">
        <div class="brand">beatmap<span>harvest</span></div>

        <NavEntry Href="beatmaps" Text="Beatmaps" Match="NavLinkMatch.All" Enabled="Setup.HasCredentials" DisabledHint="@NeedsCredentials" />
        @if (Setup.HasCredentials && _profiles.Count > 0)
        {
            @* One entry per harvested profile; the signed-in user's own profile comes first, in bold. *@
            <div class="nav-sub">
                @foreach (var profile in _profiles)
                {
                    <NavLink class="@($"nav-sub-item{(IsMe(profile) ? " me" : "")}")" href="@ProfileHref(profile)" Match="NavLinkMatch.All"
                             title="@ProfileTitle(profile)">
                        <span class="nav-sub-name">@profile.Username</span>
                        <small>@profile.Mapsets</small>
                    </NavLink>
                }
            </div>
        }
        <NavEntry Href="friends" Text="My friends" Enabled="@(Setup.HasCredentials && Account.User is not null)"
                  DisabledHint="@(Setup.HasCredentials ? "Sign in with your osu! account in Settings" : NeedsCredentials)" />
        <NavEntry Href="downloads" Text="Downloads" Enabled="Setup.HasCredentials" DisabledHint="@NeedsCredentials" />
        <NavEntry Href="library" Text="osu! library" Enabled="Setup.HasCredentials" DisabledHint="@NeedsCredentials" />
        <NavEntry Href="collections" Text="Collections" Enabled="Setup.HasCredentials" DisabledHint="@NeedsCredentials" />
        <NavEntry Href="skins" Text="Skins" Enabled="Setup.HasCredentials" DisabledHint="@NeedsCredentials" />
        <NavEntry Href="settings" Text="Settings" />
    </nav>
    <main class="content">
        <div class="page">
            @Body
        </div>
    </main>
</div>

@code {
    private const string NeedsCredentials = "Add your osu! API credentials in Settings first";

    private IReadOnlyList<ProfileEntry> _profiles = [];

    protected override void OnInitialized()
    {
        Refresh();
        Profiles.Changed += OnChanged;
        Setup.Changed += OnChanged;
        Account.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void Refresh()
    {
        var me = Account.User?.UserId;
        _profiles = Profiles.Profiles
            .OrderByDescending(p => p.UserId == me)
            .ToList();
    }

    private bool IsMe(ProfileEntry profile) => Account.User?.UserId == profile.UserId;

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        Guard();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Guard();

    /// <summary>Keeps the user out of tabs that are not available yet (e.g. through a link).</summary>
    private void Guard()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        if (path.Length == 0 || path.StartsWith("settings", StringComparison.OrdinalIgnoreCase))
            return;
        if (!Setup.HasCredentials)
            Nav.NavigateTo("settings", replace: true);
        else if (path.StartsWith("friends", StringComparison.OrdinalIgnoreCase) && Account.User is null)
            Nav.NavigateTo("beatmaps", replace: true);
    }

    private static string ProfileHref(ProfileEntry profile) =>
        string.Create(CultureInfo.InvariantCulture, $"beatmaps/{profile.UserId}");

    private static string ProfileTitle(ProfileEntry profile) =>
        $"{profile.Username} · {profile.Mapsets} beatmapsets · harvested {profile.HarvestedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)}";

    public void Dispose()
    {
        Profiles.Changed -= OnChanged;
        Setup.Changed -= OnChanged;
        Account.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
