@* Optional "Sign in with osu!" (OAuth authorization code). *@
@implements IDisposable
@inject OsuAccount Account
@inject HarvestSession Harvest
@inject NavigationManager Nav

<section class="panel">
    <h2>@L["osu! account"] <small class="muted">@L["optional"]</small></h2>

    @if (Account.User is { } user)
    {
        <div class="account-row">
            @if (user.AvatarUrl is not null)
            {
                <img class="avatar" src="@user.AvatarUrl" alt="" />
            }
            <div class="account-text">
                <b>@user.Username</b>
                <div class="muted">@L["Signed in. Your profile stays at the top of Beatmaps, and My friends is available."]</div>
            </div>
            <button class="btn" disabled="@_busy" @onclick="SignOutAsync">@L["Sign out"]</button>
        </div>
    }
    else
    {
        <p class="muted">
            @L["Sign in to get your own profile and your friends. You approve the app on the osu! website; it never sees your password."]
            @L["If your OAuth application has no callback URL yet, add"] <code>@OsuAccount.RedirectUri</code>
            <button class="btn small" @onclick="CopyRedirect">@L[_copied ? "Copied" : "Copy"]</button>
        </p>
        <div class="actions">
            @if (Account.IsSigningIn)
            {
                <span class="spinner"></span>
                <span>@L["Waiting for you to approve in the browser…"]</span>
                <button class="btn" @onclick="Account.CancelSignIn">@L["Cancel"]</button>
            }
            else
            {
                <button class="btn primary" disabled="@(!HasCredentials)" @onclick="SignInAsync">@L["Sign in with osu!"]</button>
                @if (!HasCredentials)
                {
                    <span class="muted">@L["Save your client id and secret first."]</span>
                }
            }
        </div>
    }

    @if (_message is not null)
    {
        <div class="callout @(_ok ? "ok" : "error")">@_message</div>
    }
</section>

@code {
    [Parameter] public bool HasCredentials { get; set; }

    private bool _busy;
    private bool _copied;
    private bool _ok;
    private string? _message;

    protected override void OnInitialized() => Account.Changed += OnChanged;

    private async Task SignInAsync()
    {
        _message = null;
        try
        {
            await Account.SignInAsync();
            _ok = true;
            _message = L.F("Signed in as {0}.", Account.User?.Username);

            // Signing in harvests your own profile right away; Beatmaps shows the progress and then your maps.
            if (Account.User is { } me)
            {
                Harvest.Start(new UserReference(me.UserId.ToString(CultureInfo.InvariantCulture), null));
                Nav.NavigateTo("beatmaps");
            }
        }
        catch (OsuApiException ex)
        {
            _ok = false;
            _message = L[ex.Message];
        }
        catch (HttpRequestException ex)
        {
            _ok = false;
            _message = L.F("Could not reach osu.ppy.sh: {0}", ex.Message);
        }
    }

    private async Task SignOutAsync()
    {
        _busy = true;
        try
        {
            await Account.SignOutAsync();
            _ok = true;
            _message = L["Signed out."];
        }
        finally
        {
            _busy = false;
        }
    }

    private void CopyRedirect()
    {
        ClipboardHelper.Copy(OsuAccount.RedirectUri.ToString());
        _copied = true;
    }


    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Account.Changed -= OnChanged;
}
